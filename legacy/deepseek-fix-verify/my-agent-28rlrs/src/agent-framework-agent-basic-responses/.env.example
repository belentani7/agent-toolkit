# Environment variables for the basic responses agent

# Required: Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com/api/projects/your-project

# Required: Model deployment name (set via azd or manually)
AZURE_AI_MODEL_DEPLOYMENT_NAME=your-model-deployment-name

# Optional: Alternative model name env var
# FOUNDRY_MODEL_NAME=your-model-deployment-name

# Optional: Azure Monitor / Application Insights connection string for tracing
# Get this from your Application Insights resource in Azure Portal
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Optional: OTLP endpoint for exporting traces (e.g., Jaeger, Zipkin, or custom collector)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional: Disable console span export (default: true)
# OTEL_CONSOLE_EXPORT=false

# Optional: Service name for tracing
# OTEL_SERVICE_NAME=agent-framework-agent-basic-responses