# Guarda este archivo localmente y exclúyelo del control de versiones.
# Elige la URL que corresponde a tu región, workspace y plan de Alibaba Cloud Model Studio.
BAILIAN_API_KEY=replace-me-locally
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# El template qwen-code-settings.v3.jsonc usa estas variables.
# Para Coding Plan o Token Plan, sustituye BAILIAN_API_KEY, QWEN_BASE_URL,
# el nombre de variable envKey y el modelo por el bloque oficial de tu plan.
