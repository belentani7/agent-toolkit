{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "cli/dist",
    "rootDir": "cli/src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["cli/src/**/*.ts"]
}
