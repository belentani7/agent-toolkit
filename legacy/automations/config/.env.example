# === BELENTANI7 AUTOMATION CONFIG ===
# Copiar este archivo como .env y rellenar con tus tokens reales

# Hugging Face (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# GitHub (ya configurado via gh CLI)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Gumroad API (https://app.gumroad.com/settings/advanced)
GUMROAD_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Email (para automations de email marketing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=belentani7pedro@gmail.com
SMTP_PASS=xxxx_app_password_xxxx

# Social Media APIs (cuando estén disponibles)
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# n8n (self-hosted)
N8N_HOST=http://localhost:5678
N8N_API_KEY=

# Notion (opcional, para CRM)
NOTION_TOKEN=
NOTION_DATABASE_ID=
