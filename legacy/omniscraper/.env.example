# ============================================================
#  Bellacore Lead Engine - Variables de entorno
#  Copia este archivo a `.env` y rellena con tus valores.
#  NUNCA subas tu `.env` real al repositorio.
# ============================================================

# Clave de API de Google Places (Text Search).
# Obtén una en: https://console.cloud.google.com/apis/credentials
# Sin esta clave el motor funciona en modo DEMO (datos ficticios).
GOOGLE_PLACES_KEY=

# Timeout por petición a Google Places (segundos). Default: 10
PLACES_TIMEOUT=10

# Timeout por sitio web scrapeado (segundos). Default: 6
SCRAPE_TIMEOUT=6

# Peticiones web simultáneas durante el scraping. Default: 5
MAX_CONCURRENT_SCRAPES=5

# Orígenes CORS permitidos separados por comas. Vacío = sin orígenes de navegador.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
