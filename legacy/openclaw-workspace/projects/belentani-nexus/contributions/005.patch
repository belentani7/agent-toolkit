@@ -1060,3 +1060,41 @@ class DynamicPipelineTester(unittest.TestCase):
         self.assertListEqual(
             nested_simplify([{"label": results["label"], "score": results["score"]}]), nested_simplify(new_results)
         )
+
+
+class PipelineDeviceValidationTest(unittest.TestCase):
+    """Tests for early `device` validation in `pipeline()` (#47869).
+
+    An invalid device string must raise immediately ÔÇö before any model download
+    or weight loading ÔÇö instead of crashing later at tensor placement.
+    """
+
+    def test_invalid_device_string_raises_before_download(self):
+        from transformers.pipelines import _validate_pipeline_device
+
+        with self.assertRaises(ValueError) as ctx:
+            _validate_pipeline_device("mpx")
+        self.assertIn("mpx", str(ctx.exception))
+
+        # A garbage device string must also be rejected by `pipeline()` itself,
+        # and the failure must happen before any Hub interaction.
+        with self.assertRaises(ValueError):
+            pipeline("text-classification", model="hf-internal-testing/tiny-random-distilbert", device="mpx")
+
+    def test_valid_device_values_pass_validation(self):
+        import torch
+
+        from transformers.pipelines import _validate_pipeline_device
+
+        self.assertIsNone(_validate_pipeline_device(None))
+        self.assertEqual(_validate_pipeline_device(0), 0)
+        self.assertEqual(_validate_pipeline_device(-1), -1)
+        self.assertEqual(_validate_pipeline_device("cpu"), "cpu")
+        self.assertEqual(_validate_pipeline_device("cuda:0"), "cuda:0")
+        self.assertEqual(_validate_pipeline_device(torch.device("cpu")), torch.device("cpu"))
+
+    def test_invalid_device_type_raises(self):
+        from transformers.pipelines import _validate_pipeline_device
+
+        with self.assertRaises(ValueError):
+            _validate_pipeline_device([0])
