 def generate_toc_lines(content: str) -> List[str]:
     """
     Generate markdown list lines for headings (## to ######) in content.
+
+    Headings inside fenced code blocks are ignored. Both backtick (```) and
+    tilde (~~~) fences are tracked: a fence stays open until a closing fence
+    that uses the same character and is at least as long as the opener, so a
+    literal ``` line cannot prematurely close a longer ```` fence and tilde
+    fences are not mistaken for content.
     """
     lines = content.splitlines()
     headings = []
-    in_code = False
+    fence_char = None  # "`" or "~" while inside a fence, else None
+    fence_len = 0  # length of the opening fence marker
     for line in lines:
-        if line.strip().startswith("```"):
-            in_code = not in_code
-            continue
-        if in_code:
+        stripped = line.strip()
+        if fence_char is None:
+            # Detect a fence opener: 3+ of the same character. A backtick
+            # opener's info string must not contain a backtick (CommonMark).
+            if stripped.startswith("```"):
+                fence_len = len(stripped) - len(stripped.lstrip("`"))
+                if "`" not in stripped[fence_len:]:
+                    fence_char = "`"
+                continue
+            if stripped.startswith("~~~"):
+                fence_len = len(stripped) - len(stripped.lstrip("~"))
+                fence_char = "~"
+                continue
+        else:
+            # Only a fence closer with the same character and at least the
+            # same length closes the current fence.
+            closer = fence_char * 3
+            if stripped.startswith(closer) and stripped.rstrip(fence_char) == "":
+                if len(stripped) >= fence_len:
+                    fence_char = None
+                    fence_len = 0
             continue
+
         m = re.match(r"^(#{2,6})\s+(.*)$", line)
         if not m:
             continue
