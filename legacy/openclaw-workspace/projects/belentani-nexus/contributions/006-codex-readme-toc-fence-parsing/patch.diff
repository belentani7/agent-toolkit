+#!/usr/bin/env python3
+"""Regression tests for scripts/readme_toc.py fence handling (#41077)."""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+
+from readme_toc import generate_toc_lines
+
+
+def test_tilde_fenced_headings_are_excluded():
+    content = "\n".join(
+        [
+            "## Before",
+            "~~~markdown",
+            "## Not a heading",
+            "~~~",
+            "## After",
+        ]
+    )
+    toc = generate_toc_lines(content)
+    assert toc == ["- [Before](#before)", "- [After](#after)"], toc
+
+
+def test_longer_backtick_fence_is_not_closed_by_triple_backtick():
+    content = "\n".join(
+        [
+            "## Outside",
+            "````markdown",
+            "```",
+            "## Inside is not a heading",
+            "```",
+            "````",
+            "## Also outside",
+        ]
+    )
+    toc = generate_toc_lines(content)
+    assert toc == ["- [Outside](#outside)", "- [Also outside](#also-outside)"], toc
+
+
+def test_backtick_fences_still_work():
+    content = "\n".join(
+        [
+            "## One",
+            "```py",
+            "## commented code, not a heading",
+            "```",
+            "## Two",
+        ]
+    )
+    toc = generate_toc_lines(content)
+    assert toc == ["- [One](#one)", "- [Two](#two)"], toc
+
+
+if __name__ == "__main__":
+    test_tilde_fenced_headings_are_excluded()
+    test_longer_backtick_fence_is_not_closed_by_triple_backtick()
+    test_backtick_fences_still_work()
+    print("all readme_toc fence tests passed")
