# ============================================
# BELENTANI NEXUS - API Keys Configuration
# ============================================
# Copia este archivo como .env y rellena tus keys
# ============================================

# === APIs GRATUITAS (recomendadas) ===

# Google Gemini (gratis, muy potente)
# Obtener: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq (gratis, ultra rápido)
# Obtener: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Z.AI / GLM (gratis, modelos chinos)
# Obtener: https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_key_here

# SiliconFlow (gratis, Qwen + DeepSeek)
# Obtener: https://cloud.siliconflow.cn/
SILICON_API_KEY=your_silicon_key_here

# === TOKEN PLAN (prioritario) ===

# Alibaba DashScope (Qwen Token Plan)
# Obtener: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_key_here

# === GENERACIÓN DE IMAGEN ===

# Fal.ai (Flux, gratis con límites)
# Obtener: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Stability AI (Stable Diffusion)
# Obtener: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_key_here

# === GENERACIÓN DE VIDEO ===

# MiniMax / Hailuo AI (video generation)
# Obtener: https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_key_here

# Luma AI (Dream Machine)
# Obtener: https://lumalabs.ai/
LUMA_API_KEY=your_luma_key_here

# === OPCIONALES ===

# OpenRouter (acceso a 50+ modelos)
# Obtener: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Replicate (modelos open source)
# Obtener: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# ============================================
# NOTAS:
# - Las APIs gratuitas son suficientes para empezar
# - Token Plan de Qwen es prioritario (ya pagado)
# - No necesitas todas las keys, solo las que uses
# ============================================
